# -*- coding: utf-8 -*-
import os, sys
import osen
import time
import numpy as np
from sklearn.neighbors import KNeighborsClassifier
from sklearn.svm import SVC
from sklearn.preprocessing import StandardScaler
import openturns as ot
import pickle

## Script pour créer des émulateurs à partir de simulations
## lancées précédement.

def format_file_path(file_path, total_length=80):
    prefix = "Reading file : "
    if len(prefix + file_path) > total_length:
        over_by = len(prefix + file_path) - total_length + 3  # +3 pour "...".
        file_path = "..." + file_path[-(len(file_path) - over_by):]
    return prefix + file_path

def read_simulations(sim_path, dosetype="Efficace", amplitude=None, lenght=None):
    """
    Lit les fichiers de simulation à partir de plusieurs chemins de fichiers
    donnés et retourne une concaténation des résultats.

    Args:
        sim_path (str or list of str): Chemin(s) vers le(s) répertoire(s)
        contenant les fichiers de simulation.
        dosetype (str, optional): Type de dose à lire, par défaut "Efficace".
        amplitude (list, optional): Amplitude du terme source à utiliser
        avec les données.

    Returns:
        np.ndarray: Tableau NumPy 3D contenant les résultats de toutes les
        simulations.

    Raises:
        ValueError: Si sim_path n'est pas une chaîne de caractères ni une
        liste de chaînes de caractères.

    """
    ## Vérification du format de result_type
    if type(sim_path) == str:
        paths = [sim_path]
    elif type(sim_path) == list:
        paths = sim_path
    else:
        print("Error: sim_path must be a string or a list of string")


    ## Initialisation du dictionnaire
    simulations = {}

    ## Boucle sur les répertoires
    for ipath, path in enumerate(paths):

        lenght_ = lenght

        first_pass = True
        dir_list = os.listdir(path)
        n_dataset = len(dir_list)

        ## On prend l'amplitude correspondante
        if amplitude == None:
            ampli = 100. * np.ones(n_dataset)
        else:
            ampli = amplitude[ipath]

        if lenght_ == None:
            lenght_ = n_dataset

        ## Boucle sur les simulations du repertoire
        for idir, dirname in enumerate(sorted(dir_list)[:lenght_]):

            ## On lit le fichier
            file_path = os.path.join(path, dirname, "Dose_"+dosetype+".npy")
            print(format_file_path(file_path))
            dose = np.load(file_path)

            ## On initie la valeur du tableau
            if first_pass:
                shape = dose.shape
                simulations[path] = np.zeros((ampli.shape[1] * lenght_, shape[1], shape[2]))
                first_pass = False

            ## On extrait la valeur au dernier pas de temps
            for copy in range(ampli.shape[1]):
                simulations[path][copy * lenght_ + idir,:,:] = \
                    dose[-1, :, :] * ampli[idir,copy]/100.

    # On concatène tous les résultats venant de chemin différents
    return np.concatenate(list(simulations.values()), axis=0)


if __name__ == "__main__":

    debut = time.time()

    # Vérifier si l'utilisateur a bien passé un argument
    if len(sys.argv) != 2:
        print("Usage: python create.py <param_file>")
        sys.exit(1)

    # Récupérer le fichier de paramètres depuis les arguments de la ligne de commande
    param_file = sys.argv[1]

    # Lecture des données dans le fichier de param
    param = osen.load_parameters(param_file)

    ## Définition des variables de paramètrage
    output_path = param["output_path"]
    simulation_name = param["simulation_name"]
    stability_list = param["stability"]
    doe_path = os.path.join(output_path, "doe")

    ## Lecture des plans d'expérience
    variable_names, doe_train = osen.read_doe(
        os.path.join(doe_path, "DOE_train.txt"))

    ## Nombre de simulations
    n_train = doe_train.shape[0]

    ## Génération des amplitudes du terme source
    amplitude = [osen.create_double_amplitude(n_train)]
    amplitude_complete = np.array([np.concatenate(
        (amplitude[0][:,0], amplitude[0][:,1]), axis=0)]).T

    doe = np.concatenate(
        (np.concatenate((doe_train, doe_train), axis=0), amplitude_complete),
        axis=1)

    # Normalisation du plan d'expérience
    scaler = StandardScaler()
    doe_normalized = scaler.fit_transform(doe)

    ## Lecture des coordonnées du maillage
    CoordX = np.load(os.path.join(output_path, 'CoordX.npy'))
    CoordY = np.load(os.path.join(output_path, 'CoordY.npy'))
    R = np.sqrt(CoordX**2 + CoordY**2)
    THETA = np.arctan2(CoordY, CoordX) * 180/np.pi %360
    THETA[:,0] = THETA[:,1]

    threshold_list = {"Efficace" : [10, 50], "Inhalation" : [50]}

    ## Lecture des données de dose
    dose = {}
    distance = {}
    width = {}
    classification = {}
    krigeage = {}

    ## Boucle sur la dose
    for dosetype in ["Efficace", "Inhalation"]:
        dose[dosetype] = {}
        distance[dosetype] = {}
        width[dosetype] = {}
        classification[dosetype] = {}
        krigeage[dosetype] = {}

        ## Boucle sur les stabilités de l'air
        for stability in stability_list:

            ## Répertoires qui contiennent les données d'apprentissage
            paths = [os.path.join(output_path, 'simulations/', simulation_name + "_" +
                                  dataset + "_" + stability)
                     for dataset in ["train"]]

            ## Lecture des résultats de dose
            dose[dosetype][stability] = read_simulations(paths, dosetype,
                                                         amplitude=amplitude)

            distance[dosetype][stability] = {}
            width[dosetype][stability] = {}
            classification[dosetype][stability] = {}
            krigeage[dosetype][stability] = {}

            for threshold in threshold_list[dosetype]:

                classification[dosetype][stability][threshold] = {}
                krigeage[dosetype][stability][threshold] = {}

                ## Calcul des distances
                distance[dosetype][stability][threshold] = np.array([
                    osen.distance(R, 1e3 * dd, threshold, norm='log')
                    for dd in dose[dosetype][stability]])

                ## Filtrage sur les distance non-nulles
                filter_distance = 1 - (np.array(distance[dosetype][stability][threshold]) == 0.)

                ## Classification sur les distance
                #classification_algo = KNeighborsClassifier(n_neighbors=5, weights='distance')
                classification_algo = SVC(kernel='poly')
                classification_algo.fit(doe_normalized, filter_distance)
                classification[dosetype][stability][threshold]["distance"] = classification_algo

                ## Krigeage
                input_kriging = ot.Sample(doe[filter_distance == 1])
                output_kriging = ot.Sample(
                    [[di] for di in distance[dosetype][stability][threshold][filter_distance == 1]])
                covariance_model = ot.MaternModel([1.0], 2.5)
                basis = ot.ConstantBasisFactory(5).build()
                model = ot.KrigingAlgorithm(input_kriging, output_kriging, covariance_model, basis)
                model.run()
                metamodel = model.getResult().getMetaModel()
                krigeage[dosetype][stability][threshold]["distance"] = metamodel


                ## Calcul des ouvertures
                width[dosetype][stability][threshold] = np.array([
                    osen.largeur(R, THETA, 1e3 * dd, threshold, norm='log')
                    for dd in dose[dosetype][stability]])

                ## Filtrage sur les ouvertures angulaires : 0,1,2 en fonction de
                ## si c'est entre 0 et 180 ou ailleurs
                filter_width = np.where(width[dosetype][stability][threshold] == 0, 0,
                                        np.where(width[dosetype][stability][threshold] > 180, 2, 1))

                ## Classification sur les ouvertures angulaires
                # neighKNC = KNeighborsClassifier(n_neighbors=5, weights='distance')
                classification_algo = SVC(kernel='poly')
                classification_algo.fit(doe_normalized, filter_width)
                classification[dosetype][stability][threshold]["width"] = classification_algo

                ## Krigeage
                input_kriging = ot.Sample(doe[filter_width == 1])
                output_kriging = ot.Sample(
                    [[wi] for wi in width[dosetype][stability][threshold][filter_width == 1]])
                covariance_model = ot.MaternModel([1.0], 2.5)
                basis = ot.ConstantBasisFactory(5).build()
                model = ot.KrigingAlgorithm(input_kriging, output_kriging, covariance_model, basis)
                model.run()
                metamodel = model.getResult().getMetaModel()
                krigeage[dosetype][stability][threshold]["width"] = metamodel


    ## Export des données des émulateurs
    metamodel_path = os.path.join(output_path, 'emulations/')
    osen.makedir(metamodel_path)
    pickle.dump(dose, open(metamodel_path + 'dose.pickle', 'wb'))
    pickle.dump(distance, open(metamodel_path + 'distance.pickle', 'wb'))
    pickle.dump(width, open(metamodel_path + 'width.pickle', 'wb'))
    pickle.dump(classification, open(metamodel_path + 'classification.pickle', 'wb'))
    pickle.dump(krigeage, open(metamodel_path + 'krigeage_geometrique.pickle', 'wb'))
    pickle.dump(scaler, open(metamodel_path + 'scaler.pickle', 'wb'))

    fin = time.time()
    print("Emulators created in %.02f minutes" %((fin-debut)/60))
